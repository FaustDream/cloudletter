// Cloudletter V2 · Prisma Schema（内容真相源 = Markdown 文件；SQLite 只存元数据/历史/登录）
// 已收敛：删除 Folder/Media/AuditLog/BuildJob，去掉 User.role、Post.type/folderId、trashed 状态。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  nickname       String    @default("")
  lastLoginAt    DateTime?
  lastLoginIp    String    @default("")
  lastLoginAgent String    @default("")
  // 头像系统：图片地址 + 装饰（边框/徽章/动效），见设置·账户
  avatar         String    @default("")
  avatarFrame    String    @default("")
  avatarBadge    String    @default("")
  // 登录失败防护：连续失败计数 + 锁定截止时间（服务端强制）
  loginFailCount Int       @default(0)
  loginLockedUntil DateTime?
  // 两步验证（TOTP）：secret 为空=未设置；enabled 才会在登录时要求验证码
  totpSecret     String    @default("")
  totpEnabled    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  sessions       Session[]
}

// 邮箱验证码 / 重置链接令牌（仅存哈希，链接中的明文密文不落库；过期自动失效）
model MailCode {
  id        String    @id @default(cuid())
  email     String
  purpose   String // login | reset
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // “记住我”长会话标记：续期时保持 30 天长 TTL
  remembered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// 文章：SQLite 仅作元数据索引；正文真相源在 Markdown 文件（apps/blog/src/content/posts）。
model Post {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  summary      String     @default("")
  rawMarkdown  String // 工作副本（镜像），供编辑/搜索；文件为权威
  frontmatter  String     @default("{}")
  status       String     @default("draft") // draft | published
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])
  tags         PostTag[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publishedAt  DateTime?
  // 正文字符数（列表/统计用，避免全量拉取 rawMarkdown 计算；写入时维护）
  charCount    Int        @default(0)
  revisions    Revision[]

  @@index([status])
  @@index([publishedAt])
  @@index([updatedAt])
  @@index([categoryId])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  posts       Post[]
  notes       NoteItem[] // 灵感笔记与文章共用同一套分类
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
  notes NoteTag[] // 灵感笔记与文章共用同一套标签
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// 版本历史：DB 存元数据（version/时间/摘要），正文快照存文件 projects/.revisions/<slug>/<version>.md
model Revision {
  id        String   @id @default(cuid())
  version   Int
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  summary   String   @default("")
  createdAt DateTime @default(now())

  @@unique([postId, version])
  @@index([postId])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============ 个人工作台（本地数据，单人管理员即可，数据随服务持久化） ============

// 今日计划（待办）
model PlanItem {
  id        String   @id @default(cuid())
  text      String
  level     String   @default("P1") // P0 | P1 | P2
  note      String   @default("")
  done      Boolean  @default(false)
  dueDate   String   @default("") // YYYY-MM-DD，空 = 无截止
  doneAt    String   @default("") // 完成时间（ISO），空 = 未完成
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueDate])
  @@index([done])
}

// 习惯打卡（log: {"YYYY-MM-DD": true}，逐日记录）
model CheckinItem {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("✨")
  log       String   @default("{}")
  streak    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 记账本（流水）
model LedgerEntry {
  id        String   @id @default(cuid())
  kind      String   // income | expense
  cat       String   @default("其他")
  amount    Float
  note      String   @default("")
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([date])
  @@index([kind])
}

// 长期目标（可关联今日计划/习惯，形成目标 → 拆解 → 每日行动）
model GoalItem {
  id               String   @id @default(cuid())
  name             String
  emoji            String   @default("🎯")
  current          Float    @default(0)
  target           Float
  unit             String   @default("")
  relatedPlanIds   String   @default("[]") // JSON 数组：关联的今日计划 id 列表
  relatedCheckinIds String  @default("[]") // JSON 数组：关联的习惯 id 列表
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 灵感笔记（速记与其同源）：与文章共用 Category / Tag 体系；
// 计划类速记已并入今日计划（PlanItem），本表只存灵感
model NoteItem {
  id         String    @id @default(cuid())
  title      String
  body       String    @default("")
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tags       NoteTag[]
  date       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([categoryId])
}

// 笔记↔标签 中间表（与 PostTag 同构）
model NoteTag {
  noteId String
  tagId  String
  note   NoteItem @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

// 工作计划任务（周一~周五工作安排为核心）：date 归属工作日，note 为 Markdown 全文
model WorkTask {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  text      String
  note      String   @default("")
  done      Boolean  @default(false)
  doneAt    String   @default("") // 完成时间（ISO），空 = 未完成
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([done])
}

// 一次性授权：管理员创建 → 邮件链接 → 访客 redeem 换取受限只读会话
model AccessGrant {
  id          String    @id @default(cuid())
  email       String
  label       String    @default("")
  scopes      String    @default("[]") // JSON 数组：timeline | posts | notes | workplan | plan
  tokenHash   String    @unique
  expiresAt   DateTime
  firstUsedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  sessions GuestSession[]

  @@index([email])
}

// 访客会话（由授权链接 redeem 派生；TTL ≤ 授权有效期）
model GuestSession {
  id        String   @id @default(cuid())
  grantId   String
  grant     AccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([grantId])
}

// ============ 安全与活动日志（隐私与安全 · 数据留痕，普通用户不可删改） ============

// 活动日志：重大操作必须留痕；服务端仅追加，无更新/删除接口
model ActivityLog {
  id        String   @id @default(cuid())
  action    String // login | logout | password_change | email_change | profile_update | tfa_enable |
                   // tfa_disable | tfa_reset | post_create | post_update | post_delete | post_restore |
                   // data_export | data_import | log_export | log_import | site_config |
                   // api_cred_create | api_cred_revoke | webhook_create | webhook_update | webhook_delete ...
  object    String   @default("") // 操作对象（文章标题/模块名/凭据名/Webhook 名…）
  target    String   @default("") // 目标实体 id/slug
  result    String   @default("ok") // ok | fail
  detail    String   @default("") // JSON 详情（客户端/IP/摘要等）
  client    String   @default("") // User-Agent
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// 登录设备/会话记录：区分「服务器信息」与「用户实际登录客户端信息」
model LoginRecord {
  id        String   @id @default(cuid())
  time      DateTime @default(now())
  ip        String   @default("")
  ua        String   @default("")
  client    String   @default("browser") // 客户端类型
  os        String   @default("")
  browser   String   @default("")
  geo       String   @default("") // 地理位置（尽力而为，失败留空）
  deviceId  String   @default("") // 客户端设备标识（cl_dev cookie）
  status    String   @default("ok") // ok | fail
  detail    String   @default("") // 失败原因等

  @@index([time])
}

// 发布订阅（RSS）：订阅的其他博客
model RssSubscription {
  id            String   @id @default(cuid())
  url           String   @unique
  title         String   @default("")
  siteUrl       String   @default("")
  description   String   @default("")
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  items         RssItem[]
}

model RssItem {
  id          String   @id @default(cuid())
  subId       String
  sub         RssSubscription @relation(fields: [subId], references: [id], onDelete: Cascade)
  guid        String
  title       String
  link        String   @default("")
  author      String   @default("")
  summary     String   @default("")
  publishedAt DateTime?
  fetchedAt   DateTime @default(now())

  @@unique([subId, guid])
  @@index([fetchedAt])
}

// API 凭据（集成与链接）：仅存哈希，明文密钥只在创建时展示一次
model ApiCredential {
  id         String    @id @default(cuid())
  name       String
  prefix     String    @unique // clk_<随机前缀>（展示用）
  keyHash    String    @unique
  scopes     String    @default("[]") // JSON 数组：posts.read | posts.write | timeline.read ...
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// Webhook（集成与链接）：请求体 HMAC 签名；调用留痕
model Webhook {
  id         String   @id @default(cuid())
  name       String
  url        String
  events     String   @default("[]") // JSON 数组：post.published | post.created | post.updated ...
  secret     String   @default("") // 签名密钥（仅存本服务，不对外展示）
  enabled    Boolean  @default(true)
  lastStatus Int      @default(0)
  lastError  String   @default("")
  lastSentAt DateTime?
  createdAt  DateTime @default(now())
  calls      WebhookCall[]

  @@index([enabled])
}

model WebhookCall {
  id        String   @id @default(cuid())
  webhookId String
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event     String
  payload   String   @default("{}")
  status    Int      @default(0)
  error     String   @default("")
  sentAt    DateTime @default(now())

  @@index([webhookId])
  @@index([sentAt])
}