# 云笺集 · 生产环境变量模板（仅复制到服务器使用；本文件不被部署流水线读取）
#
# 部署时复制为 /srv/cloudletter/server/.env.production 并 chmod 600：
#   scp .env.production.example root@<server>:/srv/cloudletter/server/.env.production
#   ssh root@<server> "chmod 600 /srv/cloudletter/server/.env.production"
#
# 由 systemd 单元注入、请勿在此重复的变量：
#   PORT / NODE_ENV / TZ / DATA_ROOT / DATABASE_URL / POSTS_ROOT / SETTINGS_ROOT
# （EnvironmentFile 优先级更高，重复定义会覆盖单元内同值）

# ===== 必填 =====
# CORS 白名单（逗号分隔）：生产必须为实际访问域名，否则浏览器跨域请求会被拒。
CORS_ORIGINS=https://blog.example.com

# 初始管理员：仅 pnpm seed 首次创建管理员时读取（创建完成后即可从本文件移除）。
# 生产同时作为发信收件人白名单（见下 SMTP_ALLOW_TO 说明）。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ===== SMTP（可选但推荐：不配置则验证码/解锁/重置邮件全部 503）=====
# 安全须知：
#   - SMTP_PASS 用邮箱服务商「授权码」，勿填邮箱登录密码；泄露可随时在邮箱后台吊销。
#   - 生产强制：仅 465(SMTPS) 或 587+SMTP_REQUIRE_TLS=true 允许发信，明文端口拒绝。
#   - 收件人白名单：服务器只允许发给 ADMIN_EMAIL（可用 SMTP_ALLOW_TO 扩展为 ,b@example.com），防开放中继。
#   - SMTP_HOST 填 IP 时须固定 SMTP_SERVERNAME 为原域名，保证 SNI/证书校验不被代理 DNS 劫持。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=mailer@example.com
SMTP_SERVERNAME=smtp.example.com
# SMTP_REQUIRE_TLS=true
# SMTP_ALLOW_TO=admin@example.com

# ===== 可选调优 =====
# 全局限流（每 IP 次/分钟；默认 240）。登录/发码等敏感接口另有更严格专用限流。
# RATE_LIMIT_MAX=240
# 上传配额（每 IP 每小时 MB；默认 60）
# UPLOAD_QUOTA_MB=60