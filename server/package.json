{
  "name": "cloudletter-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "云笺集 · Express + Prisma 后端服务（绞杀者模式，挂载 /api/v2/*）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "tsx scripts/drop-fts-tables.ts && prisma db push",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "backup": "tsx scripts/backup.ts",
    "migrate:content": "tsx src/migrate-blog-content.ts",
    "verify:data": "tsx src/verify-data-consistency.ts",
    "normalize:frontmatter": "tsx src/normalize-post-frontmatter.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^7.18.0",
    "vitest": "^2.1.0"
  }
}
