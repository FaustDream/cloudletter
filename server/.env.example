# 云笺集 server 环境变量（复制为 .env 使用）
PORT=3010
# 全局限流（每 IP 滑动窗口，次/分钟；用于防暴力扫描与接口滥用，登录等敏感接口另有更严格限流）
RATE_LIMIT_MAX=240
# CORS 白名单（逗号分隔；生产必须为实际域名/地址。非生产默认放行 localhost:3000-3079）
# CORS_ORIGINS=https://blog.example.com
# 上传配额（每 IP 每小时 MB；防逐次 12MB 无限上传拖垮磁盘）
# UPLOAD_QUOTA_MB=60
# SQLite 数据库文件（生产环境指向 VPS 上的 cloudletter.db）
DATABASE_URL="file:./data/cloudletter.db"
# 文章真相源与站点设置目录（已从旧博客项目迁入数据目录；默认 <dataRoot>/posts、<dataRoot>/settings）
POSTS_ROOT=./data/dev/posts
SETTINGS_ROOT=./data/dev/settings
BUILD_CMD=echo skip-build
# 初始管理员（pnpm seed 读取；本地未设置 ADMIN_PASSWORD 时默认口令为 123456，
# 已有管理员会同步为新口令——本地忘记口令时执行 pnpm seed 即可重置回 123456）
# 生产（NODE_ENV=production）必须显式提供至少 8 位的强口令，弱口令/缺失会被拒绝。
# 口令只以 scrypt 加盐散列存于数据库，绝不明文落库；生产创建完成后建议移除本行。
ADMIN_EMAIL=admin@cloudletter.local
# ADMIN_PASSWORD=change-me

# ===== SMTP（可选：配置后通过真实邮件发送验证码/解锁/重置链接；未配置时本地降级为落盘）=====
# 安全须知：
#   - SMTP_PASS 建议使用邮箱服务商提供的「授权码」（如 QQ 邮箱设置→账户→开启 SMTP 服务后生成），
#     不要把邮箱登录密码直接填这里；授权码只定权限于 SMTP 发信，泄露影响面可控，且可随时在邮箱后台吊销重发。
#   - .env 已被 gitignore，禁止提交到仓库；建议同时用系统权限把 .env 限制为仅当前用户可读写。
#   - 生产部署时优先通过进程级环境变量注入（如 systemd EnvironmentFile + 0600 权限），避免层层复制散落。
#   - SMTP_HOST 填 IP 时须固定 SMTP_SERVERNAME 为原域名，保证 SNI 与证书校验不被代理 DNS 劫持。
# 生产安全（服务端强制，不满足拒绝发信）：
#   - 必须全程 TLS：465(SMTPS) 默认；若用 587 须显式 SMTP_REQUIRE_TLS=true；明文端口(25/其他) 在生产直接拒绝。
#   - 收件人白名单：生产环境只允许发给 ADMIN_EMAIL（可用 SMTP_ALLOW_TO=,a@x.com,b@y.com 扩展），防开放中继/成本滥用。
#   - 发信有连接/礼貌/套接字超时与连接数上限，邮件服务故障不会拖垮接口；错误路径不回显授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=you@example.com
SMTP_SERVERNAME=smtp.qq.com
# SMTP_REQUIRE_TLS=true
# SMTP_ALLOW_TO=you@example.com
