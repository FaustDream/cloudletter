---
/**
 * 阅读舱沉浸态（§7）：一键隐藏导航/侧栏/TOC/banner，正文居中放大，专注阅读。
 * 键盘 `i` 或按钮切换，Esc 退出；用 CSS class 切换，无重排闪烁。
 */
---

<button id="immersive-toggle" class="immersive-toggle" title="沉浸阅读（i）" aria-label="切换沉浸阅读">
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
</button>

<script>
	const btn = document.getElementById("immersive-toggle")

	function enter() {
		document.documentElement.classList.add("immersive")
		btn?.classList.add("on")
	}
	function exit() {
		document.documentElement.classList.remove("immersive")
		btn?.classList.remove("on")
	}
	function toggle() {
		document.documentElement.classList.contains("immersive") ? exit() : enter()
	}

	btn?.addEventListener("click", toggle)

	window.addEventListener("keydown", (e) => {
		if (e.key.toLowerCase() === "i" && !e.metaKey && !e.ctrlKey && !e.altKey) {
			// 避免在输入框/编辑器中触发
			const tag = (e.target as HTMLElement)?.tagName
			if (tag === "INPUT" || tag === "TEXTAREA" || (e.target as HTMLElement)?.isContentEditable) return
			toggle()
		}
		if (e.key === "Escape") exit()
	})
</script>

<style>
.immersive-toggle {
	position: fixed;
	right: 1rem;
	bottom: 5rem;
	z-index: 45;
	display: grid;
	place-items: center;
	width: 2.5rem;
	height: 2.5rem;
	border-radius: 0.75rem;
	border: 1px solid rgb(0 0 0 / 0.08);
	background: rgb(255 255 255 / 0.8);
	backdrop-filter: blur(12px);
	color: rgb(0 0 0 / 0.55);
	cursor: pointer;
	box-shadow: 0 6px 20px rgb(0 0 0 / 0.1);
	transition: all 0.2s;
}
.dark .immersive-toggle {
	border-color: rgb(255 255 255 / 0.12);
	background: rgb(18 26 46 / 0.8);
	color: rgb(255 255 255 / 0.6);
}
.immersive-toggle:hover {
	color: var(--primary);
}
.immersive-toggle.on {
	color: var(--primary);
	border-color: var(--primary);
}

/* ===== 沉浸态：隐藏导航/侧栏/TOC/banner，正文居中放大 ===== */
html.immersive #top-row,
html.immersive #banner-wrapper,
html.immersive #toc-wrapper,
html.immersive #back-to-top-btn,
html.immersive #page-height-extend {
	display: none !important;
}
html.immersive #main-grid {
	grid-template-columns: 1fr !important;
	max-width: 48rem !important;
	margin: 0 auto !important;
}
html.immersive #main-grid > *:not(#swup-container) {
	display: none !important;
}
html.immersive #swup-container {
	max-width: 100%;
}
html.immersive .immersive-toggle {
	opacity: 0.5;
}
html.immersive .immersive-toggle:hover {
	opacity: 1;
}
</style>
