---
/**
 * wikilink 悬停预览（§5.2.4 / N9）：hover/focus [[链接]] 弹出玻璃浮层，展示目标标题与摘要。
 * 数据在构建期由 getLinkIndex 注入（内联 JSON），无运行时请求；事件委托，兼容 Swup 过渡。
 */
interface Props {
	linkIndex: Record<string, { title: string; description: string }>
}
const { linkIndex } = Astro.props
const linkIndexJson = JSON.stringify(linkIndex)
---

<div id="wikilink-preview" class="wikilink-preview" role="tooltip" aria-hidden="true"></div>

<script define:vars={{ linkIndexJson }}>
	const index = JSON.parse(linkIndexJson)
	const preview = document.getElementById("wikilink-preview")
	let current: HTMLElement | null = null
	let hideTimer: number | undefined

	function slugFromHref(href: string): string | null {
		const m = href.match(/\/posts\/([^/#]+)\/?/)
		return m ? decodeURIComponent(m[1]) : null
	}

	function show(anchor: HTMLElement) {
		const slug = slugFromHref(anchor.getAttribute("href") || "")
		if (!slug || !preview) return
		const meta = index[slug]
		if (!meta) return
		preview.innerHTML = ""
		const title = document.createElement("div")
		title.className = "wikilink-preview-title"
		title.textContent = meta.title || slug
		preview.appendChild(title)
		if (meta.description) {
			const desc = document.createElement("div")
			desc.className = "wikilink-preview-desc"
			desc.textContent = meta.description
			preview.appendChild(desc)
		}
		const hint = document.createElement("div")
		hint.className = "wikilink-preview-hint"
		hint.textContent = "点击跳转"
		preview.appendChild(hint)

		const r = anchor.getBoundingClientRect()
		preview.style.left = `${r.left + window.scrollX}px`
		preview.style.top = `${r.bottom + window.scrollY + 8}px`
		preview.classList.add("show")
		preview.setAttribute("aria-hidden", "false")
	}

	function hide() {
		if (!preview) return
		preview.classList.remove("show")
		preview.setAttribute("aria-hidden", "true")
		current = null
	}

	document.addEventListener("mouseover", (e) => {
		const anchor = (e.target as HTMLElement)?.closest?.("a.wikilink") as HTMLElement | null
		if (!anchor) return
		current = anchor
		if (hideTimer) clearTimeout(hideTimer)
		show(anchor)
	})
	document.addEventListener("mouseout", (e) => {
		const anchor = (e.target as HTMLElement)?.closest?.("a.wikilink") as HTMLElement | null
		if (anchor && anchor === current) {
			hideTimer = window.setTimeout(hide, 120)
		}
	})
	document.addEventListener("focusin", (e) => {
		const anchor = (e.target as HTMLElement)?.closest?.("a.wikilink") as HTMLElement | null
		if (anchor) show(anchor)
	})
	document.addEventListener("focusout", () => hide())
</script>

<style>
.wikilink-preview {
	position: absolute;
	z-index: 90;
	max-width: 22rem;
	padding: 0.65rem 0.85rem;
	border-radius: 0.75rem;
	border: 1px solid rgb(0 0 0 / 0.08);
	background: rgb(255 255 255 / 0.92);
	backdrop-filter: blur(12px);
	box-shadow: 0 12px 32px rgb(0 0 0 / 0.16);
	opacity: 0;
	transform: translateY(4px);
	pointer-events: none;
	transition: opacity 0.15s, transform 0.15s;
}
.dark .wikilink-preview {
	border-color: rgb(255 255 255 / 0.14);
	background: rgb(18 26 46 / 0.92);
}
.wikilink-preview.show {
	opacity: 1;
	transform: translateY(0);
}
.wikilink-preview-title {
	font-size: 0.85rem;
	font-weight: 700;
	color: rgb(0 0 0 / 0.82);
}
.dark .wikilink-preview-title {
	color: rgb(255 255 255 / 0.88);
}
.wikilink-preview-desc {
	margin-top: 0.2rem;
	font-size: 0.76rem;
	line-height: 1.5;
	color: rgb(0 0 0 / 0.5);
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}
.dark .wikilink-preview-desc {
	color: rgb(255 255 255 / 0.5);
}
.wikilink-preview-hint {
	margin-top: 0.35rem;
	font-size: 0.68rem;
	font-family: monospace;
	color: rgb(0 0 0 / 0.35);
}
.dark .wikilink-preview-hint {
	color: rgb(255 255 255 / 0.35);
}
</style>
