---
/**
 * API 侧边目录（§5.2.1 / N10）：扫描文章内 ```api 接口卡片，生成 method+path 导航浮层。
 * 点击平滑滚动定位并高亮目标卡片；无 api 块时自动隐藏；兼容 Swup。
 */
---

<div id="api-sidebar" class="api-sidebar" hidden aria-hidden="true">
	<div class="api-sidebar-head">
		<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
		<span>接口</span>
	</div>
	<div class="api-sidebar-list"></div>
</div>

<script>
	function buildApiSidebar() {
		const panel = document.getElementById("api-sidebar")
		const list = panel?.querySelector(".api-sidebar-list")
		if (!panel || !list) return

		const cards = Array.from(document.querySelectorAll(".markdown-content .cl-api-card"))
		if (!cards.length) {
			panel.hidden = true
			panel.setAttribute("aria-hidden", "true")
			return
		}
		panel.hidden = false
		panel.setAttribute("aria-hidden", "false")
		list.innerHTML = ""

		cards.forEach((card, i) => {
			const method = card.querySelector(".cl-api-method")?.textContent?.trim() || "API"
			const path = card.querySelector(".cl-api-path")?.textContent?.trim() || ""
			const id = `api-${i}`
			card.id = id

			const item = document.createElement("a")
			item.className = "api-sidebar-item"
			item.href = `#${id}`
			const m = document.createElement("span")
			m.className = `api-sidebar-method ${method.toLowerCase()}`
			m.textContent = method
			const p = document.createElement("span")
			p.className = "api-sidebar-path"
			p.textContent = path
			item.appendChild(m)
			item.appendChild(p)
			item.addEventListener("click", (e) => {
				e.preventDefault()
				card.scrollIntoView({ behavior: "smooth", block: "start" })
				card.classList.add("api-flash")
				setTimeout(() => card.classList.remove("api-flash"), 1400)
			})
			list.appendChild(item)
		})
	}

	function init() {
		buildApiSidebar()
	}

	if (window.swup?.hooks) {
		window.swup.hooks.on("page:view", init)
		window.swup.hooks.on("content:replace", init)
	}
	document.addEventListener("astro:page-load", init)
	init()
</script>

<style>
.api-sidebar {
	position: fixed;
	right: 1rem;
	top: 50%;
	transform: translateY(-50%);
	z-index: 40;
	max-width: 15rem;
	max-height: 60vh;
	overflow-y: auto;
	padding: 0.5rem;
	border-radius: 0.9rem;
	border: 1px solid rgb(0 0 0 / 0.07);
	background: rgb(255 255 255 / 0.85);
	backdrop-filter: blur(14px);
	box-shadow: 0 8px 28px rgb(0 0 0 / 0.12);
}
.dark .api-sidebar {
	border-color: rgb(255 255 255 / 0.1);
	background: rgb(18 26 46 / 0.85);
}
.api-sidebar-head {
	display: flex;
	align-items: center;
	gap: 0.4rem;
	padding: 0.3rem 0.5rem 0.5rem;
	font-size: 0.68rem;
	font-weight: 700;
	letter-spacing: 0.05em;
	text-transform: uppercase;
	color: rgb(0 0 0 / 0.4);
	border-bottom: 1px solid rgb(0 0 0 / 0.06);
}
.dark .api-sidebar-head {
	color: rgb(255 255 255 / 0.4);
	border-bottom-color: rgb(255 255 255 / 0.08);
}
.api-sidebar-item {
	display: flex;
	align-items: center;
	gap: 0.45rem;
	padding: 0.4rem 0.5rem;
	border-radius: 0.5rem;
	font-size: 0.72rem;
	text-decoration: none;
	transition: background 0.15s;
}
.api-sidebar-item:hover {
	background: rgb(0 0 0 / 0.05);
}
.dark .api-sidebar-item:hover {
	background: rgb(255 255 255 / 0.07);
}
.api-sidebar-method {
	flex: none;
	min-width: 2.6rem;
	text-align: center;
	font-family: monospace;
	font-weight: 700;
	font-size: 0.65rem;
	padding: 0.1rem 0.35rem;
	border-radius: 0.35rem;
}
.api-sidebar-method.get { color: #3ddc97; border: 1px solid #3ddc9755; }
.api-sidebar-method.post { color: #ffb454; border: 1px solid #ffb45455; }
.api-sidebar-method.put { color: #5ad1ff; border: 1px solid #5ad1ff55; }
.api-sidebar-method.delete { color: #ff5d6c; border: 1px solid #ff5d6c55; }
.api-sidebar-method.patch { color: #a98bff; border: 1px solid #a98bff55; }
.api-sidebar-path {
	flex: 1;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	font-family: monospace;
	color: rgb(0 0 0 / 0.6);
}
.dark .api-sidebar-path {
	color: rgb(255 255 255 / 0.6);
}

/* 点击目录后的目标卡片高亮 */
:global(.cl-api-card.api-flash) {
	outline: 2px solid var(--primary);
	transition: outline 0.3s;
}

@media (max-width: 1280px) {
	.api-sidebar {
		display: none;
	}
}
</style>
