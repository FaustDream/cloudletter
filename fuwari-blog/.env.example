# Umami 隐私分析（可选，默认关闭）
# 复制为 .env.production 并在部署构建时提供真实值即可启用
# 详见 https://umami.is/docs/tracker-configuration

# 是否注入 Umami 脚本：true 才启用
UMAMI_ENABLED=false

# Umami 脚本地址（以 /script.js 结尾）。自托管时改为你的域名
UMAMI_URL=https://analytics.umami.is/script.js

# Umami 后台该站点的 Website ID（必填，否则不注入）
UMAMI_WEBSITE_ID=
