# build output（apps/workbench/dist 构建产物随发版提交，便于追溯每次版本产物；其余 dist 目录仍忽略
dist/
!apps/workbench/dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# lockfiles
package-lock.json
bun.lockb
yarn.lock

# ide
.idea
*.iml

.vercel

# --- 云笺集 · 运行时产物 / 数据（§10 排除项） ---
# SQLite 数据库与 WAL 日志
*.db
*.db-journal
*.db-wal
*.db-shm

# tsx / TypeScript 编译缓存（tsx 的 node-compile-cache + tsx-<user> 缓存目录）
**/node-compile-cache/
**/tsx-*/
tsconfig.tsbuildinfo
*.tsbuildinfo

# 本地启动日志（开发辅助）
.dev-*.log
.dev-*.err

# 备份文件
*.tar.gz

# Playwright 失败截图/痕迹（保留被跟踪的 .last-run.json）
e2e/test-results/*/

# 项目数据（AI 助手记忆 / 本地状态，非源码）
.codebuddy/
.workbuddy/
